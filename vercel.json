{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "server/**",
        "hatchable/**",
        "lib/**",
        "skillswap.db",
        "package.json"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
