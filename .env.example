# ==============================================================================
# SkillSwapX — Environment Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=3005
NODE_ENV=development
APP_NAME=SkillSwapX
APP_URL=http://localhost:3005

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# Embedded SQLite Database (Default for local development)
DATABASE_TYPE=sqlite
DATABASE_PATH=skillswap.db

# Optional: PostgreSQL Connection URL (for cloud/production deployment)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/skillswap

# ------------------------------------------------------------------------------
# 3. Security & Session Management
# ------------------------------------------------------------------------------
# Secret key used for signing session cookies and tokens
SESSION_SECRET=skillswapx_super_secret_encryption_key_2026_dev
SESSION_COOKIE_NAME=skillswap_session
SESSION_MAX_AGE_DAYS=30

# PBKDF2 Password Hashing Parameters
PBKDF2_ITERATIONS=100000
PBKDF2_KEY_LEN=256
PBKDF2_DIGEST=SHA-256

# ------------------------------------------------------------------------------
# 4. Default Administrative Credentials
# ------------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@skillswap.io
ADMIN_DEFAULT_PASSWORD=Admin@123

# ------------------------------------------------------------------------------
# 5. Regional & Localization Defaults (India Context)
# ------------------------------------------------------------------------------
DEFAULT_COUNTRY=India
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR

# ------------------------------------------------------------------------------
# 6. WebRTC & Real-Time Classroom Settings
# ------------------------------------------------------------------------------
# Google Public STUN Servers for WebRTC NAT traversal
WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# ------------------------------------------------------------------------------
# 7. Email Service (Optional / Password Reset Notifications)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@skillswap.io
