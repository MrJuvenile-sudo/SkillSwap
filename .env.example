# ==============================================================================
# SkillSwapX — Environment Variables Template (.env.example)
# ==============================================================================
# IMPORTANT DEPLOYMENT RULES:
# 1. NEVER upload or commit your actual .env file to GitHub. (Kept in .gitignore)
# 2. In local development: use .env file.
# 3. In cloud production (Render, Railway, Heroku, AWS, Vercel, etc.):
#    Enter these key-value pairs directly in your hosting dashboard's
#    "Environment Variables" settings section.
# 4. NOTE ON DB_HOST:
#    DB_HOST=localhost works ONLY on your local machine.
#    In cloud deployment, 'localhost' refers to the container itself and will FAIL.
#    You must provide your cloud database host (e.g. ep-xyz.neon.tech, db.supabase.co,
#    or an internal cloud DNS host) or provide DATABASE_URL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
APP_NAME=SkillSwapX
APP_URL=https://your-domain.com

# ------------------------------------------------------------------------------
# 2. Cloud Database Connection (PostgreSQL / MySQL)
# ------------------------------------------------------------------------------
# For cloud deployments:
DB_HOST=your-cloud-db-host.com
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=skillswap
# Or complete connection string provided by cloud database providers:
DATABASE_URL=postgresql://user:password@cloud-host:5432/skillswap?sslmode=require

# Local Embedded Database (for local offline dev without separate DB server):
DATABASE_TYPE=sqlite
DATABASE_PATH=skillswap.db

# ------------------------------------------------------------------------------
# 3. Security, Authentication & Session
# ------------------------------------------------------------------------------
# Secret key used for signing JWT tokens and session cookies
JWT_SECRET=some-super-secure-random-jwt-secret
SESSION_SECRET=some-super-secure-random-session-secret
SESSION_COOKIE_NAME=skillswap_session
SESSION_MAX_AGE_DAYS=30

# PBKDF2 Password Hashing Parameters
PBKDF2_ITERATIONS=100000
PBKDF2_KEY_LEN=256
PBKDF2_DIGEST=SHA-256

# ------------------------------------------------------------------------------
# 4. Default System Administrator Credentials
# ------------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@skillswap.io
ADMIN_DEFAULT_PASSWORD=Admin@123

# ------------------------------------------------------------------------------
# 5. Localization Defaults (India Context)
# ------------------------------------------------------------------------------
DEFAULT_COUNTRY=India
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR

# ------------------------------------------------------------------------------
# 6. WebRTC & Live Classroom
# ------------------------------------------------------------------------------
WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# ------------------------------------------------------------------------------
# 7. Mail / SMTP Service (Optional)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@skillswap.io
